            "mimeType": "text/html",
            "text": "<!doctype html>\n<html lang=\"en\" data-theme=\"light\" data-palette=\"blue\" data-density=\"comfortable\" data-kit=\"default\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n    <meta name=\"description\" content=\"A framework-independent design system workspace.\">\n    <meta name=\"color-scheme\" content=\"light dark\">\n    <meta name=\"theme-color\" content=\"#ffffff\">\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\">\n    <meta name=\"studio-version\" content=\"1170b641fcdfe7977a19\">\n    <link rel=\"icon\" href=\"/PWA-Design-System/favicon.svg\" type=\"image/svg+xml\">\n    <link rel=\"manifest\" href=\"/PWA-Design-System/manifest.webmanifest\">\n    <link rel=\"apple-touch-icon\" href=\"/PWA-Design-System/icons/apple-touch-icon.png\">\n    <title>PWA Design System Studio</title>\n    <script src=\"/PWA-Design-System/theme-init.js\"></script>\n    <script src=\"/PWA-Design-System/token-prepaint.js\"></script>\n    <script type=\"module\" crossorigin src=\"/PWA-Design-System/assets/index-BE9x9WiK.js\"></script>\n    <link rel=\"stylesheet\" crossorigin href=\"/PWA-Design-System/assets/index-CjHFdpv_.css\">\n  </head>\n  <body>\n    <a class=\"studio-skip\" href=\"#main\">Skip to content</a>\n    <div class=\"studio-layout\">\n      <aside id=\"desktop-sidebar\" class=\"studio-sidebar\" aria-label=\"Studio sidebar\">\n        <a class=\"studio-brand\" href=\"#overview\"><span class=\"studio-brand-mark\" aria-hidden=\"true\">P</span><span><strong>PWA Design System</strong><small>STUDIO</small></span></a>\n        <nav class=\"studio-nav\" aria-label=\"Studio navigation\" data-studio-nav></nav>\n        <div class=\"studio-sidebar-foot\"><span>DESIGN SYSTEM</span><strong>Foundation / v0.1</strong></div>\n      </aside>\n      <div class=\"studio-content\">\n        <header class=\"studio-topbar\">\n          <div class=\"studio-topbar-context\">\n            <button type=\"button\" class=\"studio-menu-button\" id=\"open-navigation\" aria-label=\"Open navigation\" aria-haspopup=\"dialog\" aria-controls=\"mobile-navigation\"><span aria-hidden=\"true\">☰</span></button>\n            <div class=\"studio-breadcrumb\"><span>Studio</span><span aria-hidden=\"true\">/</span><strong id=\"current-page\">Overview</strong></div>\n          </div>\n          <div class=\"studio-topbar-actions\"><button type=\"button\" class=\"studio-sidebar-toggle\" id=\"toggle-sidebar\" aria-controls=\"desktop-sidebar\" aria-expanded=\"true\">Collapse sidebar</button><label class=\"studio-theme-label\" for=\"theme-select\">Studio theme</label><span class=\"studio-select-wrap\"><select id=\"theme-select\" class=\"studio-select\" name=\"theme\" aria-label=\"Studio theme\"><option value=\"light\">Light</option><option value=\"dark\">Dark</option><option value=\"system\">System</option></select></span></div>\n        </header>\n        <p id=\"pwa-connectivity\" class=\"studio-connectivity\" role=\"status\" hidden></p>\n        <p id=\"preference-status\" class=\"studio-preference-status\" role=\"status\"></p>\n        <section id=\"pwa-update\" hidden aria-label=\"Application update\"><div class=\"pwa-update-row\"><span class=\"pwa-update-loader\" aria-hidden=\"true\" hidden></span><p id=\"pwa-update-status\" role=\"status\"></p><button type=\"button\" aria-describedby=\"pwa-update-status\">Prepare update</button><button type=\"button\" data-pwa-reload hidden>Reload now</button><details><summary>Update details</summary><p>Save or cancel token drafts and finish any import. Close other Studio tabs. Preparing does not reload this page; reload only after your work is saved.</p></details></div></section>\n        <button id=\"scroll-to-top\" class=\"studio-scroll-top\" type=\"button\" hidden>Back to top</button>\n        <main id=\"main\" class=\"studio-main\" tabindex=\"-1\"><p>Loading workspace…</p></main>\n      </div>\n    </div>\n    <dialog id=\"mobile-navigation\" class=\"studio-drawer\" aria-labelledby=\"mobile-navigation-title\">\n      <div class=\"studio-drawer-header\"><div><span class=\"studio-eyebrow\">WORKSPACE</span><h2 id=\"mobile-navigation-title\">Navigation</h2></div><button id=\"close-navigation\" type=\"button\" class=\"studio-close-button\" aria-label=\"Close navigation\">×</button></div>\n      <nav class=\"studio-nav studio-drawer-nav\" aria-label=\"Mobile navigation\" data-studio-nav></nav>\n    </dialog>\n    <p id=\"route-announcement\" class=\"studio-sr-only\" role=\"status\" aria-live=\"polite\"></p>\n  </body>\n</html>\n"
