            "text": "{\n  \"id\": \"/PWA-Design-System/\",\n  \"name\": \"PWA Design System Studio\",\n  \"short_name\": \"DS Studio\",\n  \"description\": \"A framework-independent design system workspace.\",\n  \"start_url\": \"/PWA-Design-System/\",\n  \"scope\": \"/PWA-Design-System/\",\n  \"display\": \"standalone\",\n  \"background_color\": \"#ffffff\",\n  \"theme_color\": \"#ffffff\",\n  \"icons\": [\n    { \"src\": \"/PWA-Design-System/icons/icon-192.png\", \"sizes\": \"192x192\", \"type\": \"image/png\", \"purpose\": \"any\" },\n    { \"src\": \"/PWA-Design-System/icons/icon-512.png\", \"sizes\": \"512x512\", \"type\": \"image/png\", \"purpose\": \"any\" },\n    { \"src\": \"/PWA-Design-System/icons/icon-maskable-512.png\", \"sizes\": \"512x512\", \"type\": \"image/png\", \"purpose\": \"maskable\" }\n  ]\n}\n"
