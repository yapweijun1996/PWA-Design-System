{
  "name": "pwa-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --config apps/studio/vite.config.ts",
    "build": "vite build --config apps/studio/vite.config.ts",
    "preview": "vite preview --config apps/studio/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings apps/studio/src apps/studio/vite.config.ts",
    "test": "vitest run",
    "tokens:build": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "22.19.11",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
