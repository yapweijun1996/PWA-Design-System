{
  "name": "pwa-design-system",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --config apps/studio/vite.config.ts",
    "build": "vite build --config apps/studio/vite.config.ts",
    "preview": "vite preview --config apps/studio/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/core/tsconfig.json",
    "lint": "biome lint --error-on-warnings apps/studio/src apps/studio/public apps/studio/vite.config.ts scripts packages/core/src packages/tokens/src tests/unit tests/e2e tests/visual examples/vanilla playwright.config.ts packages/react/src tests/integration tests/pwa examples/react",
    "test": "vitest run --exclude 'tests/e2e/**' --exclude 'tests/pwa/**' --exclude 'tests/visual/**' --exclude 'examples/react/**'",
    "tokens:build": "node scripts/tokens.mjs && node scripts/breakpoints.mjs",
    "tokens:check": "node scripts/tokens.mjs --check && node scripts/breakpoints.mjs --check",
    "contracts:check": "node scripts/check-component-contracts.mjs",
    "ssot:check": "node scripts/check-ssot.mjs",
    "build:core": "tsc -p packages/core/tsconfig.json",
    "test:e2e": "playwright test",
    "check:artifact": "node scripts/check-studio-artifact.mjs",
    "test:production": "node scripts/test-production-preview.mjs",
    "build:react": "npm run build:core && tsc -p packages/react/tsconfig.json",
    "typecheck:react": "tsc --noEmit -p packages/react/tsconfig.json",
    "dev:react-example": "vite --config examples/react/vite.config.ts",
    "agent-validator:check": "node scripts/build-agent-validator.mjs --check",
    "agent-contract:check": "node scripts/build-agent-contract.mjs --check",
    "test:react:e2e": "playwright test -c examples/react/playwright.config.ts",
    "test:pwa": "playwright test -c tests/pwa/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "@pwa-design-system/core": "file:packages/core",
    "@pwa-design-system/react": "file:packages/react",
    "@types/node": "22.19.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "jsdom": "27.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
