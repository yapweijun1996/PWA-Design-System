        {
          "name": "name",
          "type": "string | undefined",
          "required": false,
          "defaultValue": "not supplied"
        },
        {
          "name": "ariaLabel",
          "type": "string | undefined",
          "required": false,
          "defaultValue": "not supplied"
        },
        {
          "name": "disabled",
          "type": "boolean | undefined",
          "required": false,
          "defaultValue": "false"
        },
        {
          "name": "required",
          "type": "boolean | undefined",
          "required": false,
          "defaultValue": "false"
        },
        {
          "name": "size",
          "type": "\"sm\" | \"md\" | \"lg\" | undefined",
