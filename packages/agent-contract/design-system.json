      "family": "form-field",
      "factory": "createFormField",
      "entry": "@pwa-design-system/core/form-field",
      "optionType": "FormFieldOptions",
      "keyboard": [
        "Delegates keyboard behavior to native control"
      ],
      "states": [
        "default",
        "error"
      ],
      "apiNotes": "Returns setError(message?) and restores owned description state on destroy.",
