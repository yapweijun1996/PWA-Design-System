{
  "schema": "pwa-design-system/agent-design-contract",
  "version": 1,
  "project": "PWA-Design-System",
  "packages": {
    "core": {
      "name": "@pwa-design-system/core",
      "version": "0.1.0",
      "private": true
    },
    "tokens": {
      "name": "@pwa-design-system/tokens",
      "version": "0.1.0",
      "private": true
    }
  },
  "tokens": {
    "source": "packages/tokens/",
    "cssExport": "@pwa-design-system/tokens/tokens.css",
    "axes": {
      "themes": [
        "light",
        "dark"
      ],
      "palettes": [
        "blue",
        "indigo",
        "violet",
        "emerald",
        "teal",
        "rose",
        "orange",
        "slate"
      ],
      "density": [
        "comfortable",
        "compact"
      ],
      "kits": [
        "default",
        "minimal",
        "enterprise"
      ]
    }
  },
  "components": [
    {
      "family": "button",
      "factory": "createButton",
      "entry": "@pwa-design-system/core/button",
      "optionType": "ButtonOptions",
      "keyboard": [
        "Native Tab, Enter and Space"
      ],
      "states": [
        "enabled",
        "disabled",
        "loading"
      ],
      "apiNotes": "See property types and defaults below. Preview values may differ from defaults.",
      "properties": [
        {
          "name": "label",
          "type": "string",
          "required": true,
          "defaultValue": "required"
        },
        {
          "name": "size",
          "type": "Size | undefined",
          "required": false,
          "defaultValue": "medium"
        },
        {
          "name": "variant",
          "type": "ActionVariant | undefined",
          "required": false,
          "defaultValue": "primary"
        },
        {
          "name": "disabled",
          "type": "boolean | undefined",
          "required": false,
          "defaultValue": "false"
        },
        {
          "name": "loading",
          "type": "boolean | undefined",
          "required": false,
          "defaultValue": "false"
        },
        {
          "name": "type",
          "type": "\"button\" | \"submit\" | \"reset\" | undefined",
          "required": false,
          "defaultValue": "button"
        },
        {
          "name": "onClick",
          "type": "((event: MouseEvent) => void) | undefined",
          "required": false,
          "defaultValue": "not supplied"
        }
      ]
    },
    {
      "family": "icon-button",
      "factory": "createIconButton",
