          "name": "label",
          "type": "string",
          "required": true,
          "defaultValue": "required"
        },
        {
          "name": "icon",
          "type": "string",
          "required": true,
          "defaultValue": "required"
        },
        {
          "name": "size",
          "type": "Size | undefined",
          "required": false,
          "defaultValue": "medium"
        },
        {
          "name": "variant",
          "type": "ActionVariant | undefined",
          "required": false,
          "defaultValue": "primary"
        },
        {
          "name": "disabled",
          "type": "boolean | undefined",
          "required": false,
          "defaultValue": "false"
        },
        {
          "name": "loading",
          "type": "boolean | undefined",
          "required": false,
          "defaultValue": "false"
        },
        {
          "name": "type",
          "type": "\"button\" | \"submit\" | \"reset\" | undefined",
